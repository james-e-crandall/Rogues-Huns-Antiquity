<?xml version="1.0" encoding="utf-8"?>
<GameEffects xmlns="GameEffects">
	<!-- ==================================================	-->
	<!--				Civ-Specific Traits					-->
	<!-- ==================================================	-->
	<Modifier id="MOD_CIV_WAR_SUPPORT_HUNS" collection="COLLECTION_OWNER" effect="EFFECT_DIPLOMACY_ADJUST_DIPLOMATIC_ACTION_TOKEN_BONUS">
		<Argument name="ActionType">DIPLOMACY_ACTION_DECLARE_WAR</Argument>
		<Argument name="OnlyWhenInitiator">true</Argument>
		<Argument name="Amount">3</Argument>
	</Modifier>
	<Modifier id="MOD_GET_TUNKING" collection="COLLECTION_PLAYER_COMBAT" effect="EFFECT_ADJUST_UNIT_STRENGTH_MODIFIER">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_OPPONENT_IS_DISTRICT_WITH_SPECIFIC_CONSTRUCTIBLE">
				<Argument name="ConstructibleType">BUILDING_ANCIENT_WALLS</Argument>
			</Requirement>
			<Requirement type="REQUIREMENT_PLOT_ADJACENT_UNIT_TAG_MATCHES">
				<Argument name="Tag">UNIT_CLASS_TUNKUR</Argument>
				<Argument name="IncludeCenter">false</Argument>
			</Requirement>
			<Requirement type="REQUIREMENT_UNIT_CLASS_MATCHES">
				<Argument name="UnitClass" inverse="true">UNIT_CLASS_TUNKUR</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="Amount">10</Argument>
		<String context="Preview">LOC_ABILITY_TUNKUR_PREVIEW</String>
	</Modifier>
	<!-- ==================================================	-->
	<!--				Civ-Specific Trees					-->
	<!-- ==================================================	-->

	<Modifier id="MOD_REVEAL_CIV_CULTURE_TREE_HUNS" collection="COLLECTION_OWNER" effect="EFFECT_PLAYER_REVEAL_CULTURE_TREE">
		<SubjectRequirements>
			<Requirement type="REQUIREMENT_PLAYER_HAS_CIVILIZATION_OR_LEADER_TRAIT">
				<Argument name="TraitType">TRAIT_HUNS</Argument>
			</Requirement>
		</SubjectRequirements>
		<Argument name="ProgressionTreeType">TREE_CIVICS_AQ_HUNS</Argument>
	</Modifier>


	<!-- ==================================================	-->
	<!--				Wonder Bonuses						-->
	<!-- ==================================================	-->
</GameEffects>